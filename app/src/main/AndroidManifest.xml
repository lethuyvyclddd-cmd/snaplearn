<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Cần để đăng nhập / đăng ký với Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Cần để TextToSpeech hoạt động trên Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SnapLearn">

        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.CropActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.QuizActivity"
            android:exported="false" />
        <activity
            android:name=".ui.NotebookActivity"
            android:exported="false"
            android:theme="@style/Theme.SnapLearn" />
        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.SnapLearn" />
        <activity
            android:name=".ui.CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Màn hình khởi động. Chưa đăng nhập thì tự chuyển sang LoginActivity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>