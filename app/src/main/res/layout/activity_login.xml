            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/tvForgot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="8dp" android:padding="8dp" android:text="@string/forgot_password" android:textColor="?attr/colorPrimary" android:textSize="14sp" android:textStyle="bold"/>
